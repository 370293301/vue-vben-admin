{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pnpm run dev:antd",          // ← 名称要和 preLaunchTask 完全一致
      "type": "shell",
      "command": "cmd",
      "args": ["/c","pnpm","run","dev:antd"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "ready in .*ms"
        }
      }
    }
  ]
}
